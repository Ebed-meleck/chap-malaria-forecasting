# Variables read by compose.chap-malaria-forecasting.yml. Append them to the
# .env file of the chap-core deployment directory (Compose reads it
# automatically). Never commit the resulting file.

# Immutable image published by CI: the sha-<7 chars> tag or, preferably,
# the digest printed in the CI job summary.
MALARIA_FORECASTING_IMAGE=ghcr.io/ebed-meleck/chap-malaria-forecasting@sha256:TO_SET

# Only if chap-core itself sets SERVICEKIT_REGISTRATION_KEY: same value.
# SERVICEKIT_REGISTRATION_KEY=

# Reserve capacity for CHAP Core, its worker, PostgreSQL and Valkey.
MALARIA_FORECASTING_CPUS=4.0
MALARIA_FORECASTING_MEMORY=16g
MALARIA_FORECASTING_PIDS=512
MALARIA_FORECASTING_THREADS=4

# Docker log rotation for this container.
MALARIA_FORECASTING_LOG_MAX_SIZE=20m
MALARIA_FORECASTING_LOG_MAX_FILES=5
